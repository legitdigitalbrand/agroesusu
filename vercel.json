{
  "buildCommand": "next build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/process-events",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/accrue-interest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/check-overdue",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-esusu-payouts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/process-returns",
      "schedule": "0 9 * * *"
    }
  ]
}
