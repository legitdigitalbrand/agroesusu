# ==========================================
# REQUIRED — Supabase (Authentication + Database)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# REQUIRED — Application
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# REQUIRED — Cron Job Authentication
# Generate a random string: openssl rand -hex 32
# ==========================================
CRON_SECRET=your-cron-secret

# ==========================================
# Safe Haven Banking API (Phase 2)
# Set SAFE_HAVEN_ENV=mock for development without credentials
# Set SAFE_HAVEN_ENV=sandbox for sandbox testing with real API
# ==========================================
SAFE_HAVEN_ENV=mock
# SAFE_HAVEN_API_KEY=your-oauth-client-id
# SAFE_HAVEN_SECRET_KEY=your-rsa-private-key
# SAFE_HAVEN_IBS_CLIENT_ID=your-ibs-client-id
# SAFE_HAVEN_WEBHOOK_SECRET=your-webhook-signing-secret
# Required for identity verification (BVN/NIN OTP)
SAFE_HAVEN_DEBIT_ACCOUNT=your-debit-account-number

# ==========================================
# OPTIONAL — Email (Resend) (Phase 2+)
# ==========================================
# RESEND_API_KEY=

# ==========================================
# DO NOT COMMIT .env.local
# ==========================================
