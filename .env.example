# ==========================================
# REQUIRED — Supabase (Authentication + Database)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# REQUIRED — Application
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# REQUIRED — Cron Job Authentication
# Generate a random string: openssl rand -hex 32
# ==========================================
CRON_SECRET=your-cron-secret

# ==========================================
# Safe Haven Banking API (Phase 2)
#
# REAL credentials (SAFEHAVEN_* — these are the names the factory reads).
# With both set, the REAL provider is used and SAFE_HAVEN_ENV is ignored.
#   - SAFEHAVEN_API_URL: https://api.sandbox.safehavenmfb.com (sandbox)
#                        https://api.safehavenmfb.com (production)
# ==========================================
# SAFEHAVEN_CLIENT_ID=your-oauth-client-id
# SAFEHAVEN_PRIVATE_KEY=your-rsa-private-key (multiline PEM, or see auth.ts for inline format)
# SAFEHAVEN_API_URL=https://api.sandbox.safehavenmfb.com
# SAFEHAVEN_COMPANY_URL=https://your-company-url (JWT `iss`, optional)
# SAFE_HAVEN_WEBHOOK_SECRET=your-webhook-signing-secret
# Required for identity verification (BVN/NIN OTP)
# SAFE_HAVEN_DEBIT_ACCOUNT=your-debit-account-number

# ==========================================
# LOCAL DEV ONLY — explicit opt-in to the mock banking provider.
# NEVER set this in production: no real Safe Haven calls will be made.
# ==========================================
# SAFE_HAVEN_ENV=mock

# ==========================================
# ADMIN BOOTSTRAP — one-time /dev portal setup
# ==========================================
# Set this to a long random secret, deploy, hit POST /api/dev/bootstrap ONCE
# while logged in (with header x-bootstrap-secret: <this value>) to become the
# first super_admin. The endpoint self-locks forever once any staff exists —
# after bootstrapping, you can remove this env var. See docs/DEV_PORTAL_ACCESS.md.
ADMIN_BOOTSTRAP_SECRET=

# ==========================================
# OPTIONAL — Email (Resend) (Phase 2+)
# ==========================================
# RESEND_API_KEY=

# ==========================================
# DO NOT COMMIT .env.local
# ==========================================
